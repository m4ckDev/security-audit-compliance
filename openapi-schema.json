{
  "openapi": "3.1.1",
  "info": {
    "title": "Security Compliance Auditor",
    "version": "2026.1.0"
  },
  "servers": [
    {
      "url": "YOUR_CLOUDFLARE_TUNNEL_URL_HERE",
      "description": "Cloudflare Tunnel endpoint"
    }
  ],
  "paths": {
    "/audit": {
      "post": {
        "operationId": "submitComplianceAudit",
        "security": [
          {
            "oauth2": ["audit:write"]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audit completed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "YOUR_CLOUDFLARE_TUNNEL_URL_HERE/oauth/token",
            "scopes": {
              "audit:write": "Submit audit requests"
            }
          }
        }
      }
    }
  }
}
